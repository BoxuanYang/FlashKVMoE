    --moe-backend kt \
    --kt-weight-path /data1/models/Qwen3-235B-A22B-GGUF/IQ4_XS \
    --kt-cpuinfer 64 \
    --kt-threadpool-count 2 \
    --kt-method LLAMAFILE \
    --attention-backend fi \
    --cuda-graph-max-bs 5 \
    --page-size 2 \
    --num-pages 20000 \
    --max-seq-len-override 7000 \
