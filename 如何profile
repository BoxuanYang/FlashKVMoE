export NSYS_SESSION=qwen235_minisgl_one

CUDA_VISIBLE_DEVICES=2 \
LOG_LEVEL=INFO \
LOG_PID=1 \
nsys launch \
  --session-new="$NSYS_SESSION" \
  --trace=cuda,nvtx,osrt \
  --cuda-graph-trace=node:nvtx-precapture \
  --show-output=true \
  python -u -m minisgl \
    --host 127.0.0.1 \
