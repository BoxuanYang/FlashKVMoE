终端 2：预热
curl -sS http://127.0.0.1:30000/v1/chat/completions \
  -H 'Content-Type: application/json' \
  -d '{
    "model": "/data1/models/Qwen3-235B-A22B-GGUF/IQ4_XS",
    "messages": [{"role": "user", "content": "Hello"}],
    "temperature": 0,
    "max_tokens": 16,
    "ignore_eos": true,
    "stream": false
  }' \
  -o /tmp/minisgl_warmup.json
开始采集
cd ~/FlashKVMoE
mkdir -p profiles

export NSYS_SESSION=qwen235_minisgl_one
export NSYS_OUTPUT="$PWD/profiles/qwen3_235b_single_$(date +%Y%m%d_%H%M%S)"

nsys start \
  --session="$NSYS_SESSION" \
  --sample=none \
  --cpuctxsw=none \
  --output="$NSYS_OUTPUT"
发送正式请求
curl -sS http://127.0.0.1:30000/v1/chat/completions \
  -H 'Content-Type: application/json' \
  -d '{
    "model": "/data1/models/Qwen3-235B-A22B-GGUF/IQ4_XS",
    "messages": [
      {
        "role": "user",
        "content": "Explain why the sky is blue in detail."
      }
    ],
    "temperature": 0,
    "max_tokens": 128,
    "ignore_eos": true,
    "stream": false
  }' \
  -o "${NSYS_OUTPUT}_response.json"
停止采集
nsys stop --session="$NSYS_SESSION"
检查报告：
ls -lh "${NSYS_OUTPUT}"*
结束服务：
nsys shutdown \
  --session="$NSYS_SESSION" \
  --kill=2



